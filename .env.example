NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local development; use the canonical HTTPS origin in staging/production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Server only. Add a Supabase secret key (or legacy service-role key).
SUPABASE_SECRET_KEY=
# Server only. Random secret used by the scheduled media-cleanup endpoint.
MAINTENANCE_SECRET=
# Vercel cron authorization; takes precedence over MAINTENANCE_SECRET.
CRON_SECRET=
# Optional GitHub App repository import; use a dedicated app with repository Metadata read.
GITHUB_IMPORT_CLIENT_ID=
GITHUB_IMPORT_CLIENT_SECRET=
GITHUB_IMPORT_APP_SLUG=
# Base64 of exactly 32 random bytes. Server only; rotating it disconnects import sessions.
GITHUB_IMPORT_COOKIE_KEY=
